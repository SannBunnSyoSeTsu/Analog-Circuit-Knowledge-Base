XDNNP dn holdp refp vdd sky130_fd_pr__pfet_01v8 l=0.15 w=1.68

XSPVN bp c1a vip vss sky130_fd_pr__nfet_01v8 l=0.15 w=0.84
XSPVP bp c1b vip vdd sky130_fd_pr__pfet_01v8 l=0.15 w=1.68
XSNVN bn c1a vin vss sky130_fd_pr__nfet_01v8 l=0.15 w=0.84
