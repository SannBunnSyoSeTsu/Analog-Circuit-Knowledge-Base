XCMP6 vss vdd clk vin ref6 therm6 neg6 adc_compare
XCMP7 vss vdd clk vin ref7 therm7 neg7 adc_compare
XMSB1 vss vdd therm4 msb_bar adc_inv
XMSB2 vss vdd msb_bar b2 adc_inv
XMID1 vss vdd therm2 neg4 middle_bar adc_nand2
XMID2 vss vdd middle_bar neg6 b1 adc_nand2
XLOW1 vss vdd therm1 neg2 low12_bar adc_nand2
XLOW3 vss vdd therm3 neg4 low34_bar adc_nand2
XLOW5 vss vdd therm5 neg6 low56_bar adc_nand2
XLOW7 vss vdd low12_bar low34_bar low56_bar neg7 b0 adc_nand4
.ends flash_adc_3bit
