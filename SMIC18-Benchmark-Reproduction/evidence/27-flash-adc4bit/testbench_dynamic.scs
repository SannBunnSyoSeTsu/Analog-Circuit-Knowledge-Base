simulator lang=spectre
global 0
include "/home/IC/Tech/smic_018mmrf-OA/SMIC_018_MMRF/models/spectre/ms018_v1p7_spe.lib" section=tt
include "/home/IC/CodeX/smic18_benchmark_repro/cases/27-flash-adc4bit/hd_cells.scs"
include "/home/IC/CodeX/smic18_benchmark_repro/cases/27-flash-adc4bit/circuit.scs"
VDD (vdd 0) vsource dc=1.8
VREFP (vrefp 0) vsource dc=1.8
VCM (vcm 0) vsource dc=.9
VCLK (clk_src 0) vsource type=pulse val0=0 val1=1.8 delay=1p rise=20p fall=20p width=9.96n period=20n
RCLK (clk_src clk) resistor r=50
X (clk d3 d2 d1 d0 0 vdd vinn vinp 0 vrefp) flash_adc_4bit
simulatorOptions options temp=27 tnom=27 reltol=1e-06 vabstol=1e-8 iabstol=1e-14 gmin=1e-15
saveOptions options save=selected
save d0 d1 d2 d3 vinp vinn clk_src clk VDD:p VREFP:p VCLK:p X.vhp X.vhn
C0 (d0 0) capacitor c=10f
C1 (d1 0) capacitor c=10f
C2 (d2 0) capacitor c=10f
C3 (d3 0) capacitor c=10f
VINP (vinp vcm) vsource dc=0 type=sine ampl=.85 freq=7.8125M
VINN (vinn vcm) vsource dc=0 type=sine ampl=.85 freq=7.8125M sinephase=180
tran tran stop=7.2e-07 maxstep=5e-11 method=gear2only errpreset=conservative
